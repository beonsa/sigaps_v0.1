<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.sigaps.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_collecte"
        android:name="com.example.sigaps.ui.collecte.CollecteFragment"
        android:label="Collecte"
        tools:layout="@layout/fragment_collecte">
        <action
            android:id="@+id/action_navigationCollecte_to_eleveFormFragment"
            app:destination="@id/eleveFormFragment" />
        <action
            android:id="@+id/action_navigationCollecte_to_ecoleFormFragment"
            app:destination="@id/ecoleFormFragment" />
        <action
            android:id="@+id/action_navigationCollecte_to_enseignantFormFragment"
            app:destination="@id/enseignantFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.sigaps.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.sigaps.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />


    <fragment
        android:id="@+id/eleveFormFragment"
        android:name="com.example.sigaps.ui.forms.EleveFormFragment"
        android:label="Formulaire Élève"
        tools:layout="@layout/fragment_eleve_form" />

    <fragment
        android:id="@+id/ecoleFormFragment"
        android:name="com.example.sigaps.ui.forms.EcoleFormFragment"
        android:label="Formulaire École"
        tools:layout="@layout/fragment_ecole_form" />

    <fragment
        android:id="@+id/enseignantFormFragment"
        android:name="com.example.sigaps.ui.forms.EnseignantFormFragment"
        android:label="Formulaire Enseignant"
        tools:layout="@layout/fragment_enseignant_form" />


    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.sigaps.ui.auth.LoginFragment"
        android:label="Connexion"
        tools:layout="@layout/fragment_login" /> <!-- Créez ce layout -->

</navigation>

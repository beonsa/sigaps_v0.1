<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".ui.collecte.CollecteFragment">

    <TextView
        android:id="@+id/collecte_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Section Collecte de Données"
        android:textSize="24sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/button_collecte_eleve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Collecter Élève"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_collecte_ecole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Collecter École"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_collecte_enseignant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Collecter Enseignant"/>

</LinearLayout>
